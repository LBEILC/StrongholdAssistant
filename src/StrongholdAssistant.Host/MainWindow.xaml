<Window x:Class="StrongholdAssistant.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="StrongholdAssistant" Width="380" Height="900" MinWidth="320" MaxWidth="460"
        WindowStyle="None" ResizeMode="CanResize" Loaded="OnLoaded" Icon="icon.ico" Background="#0B0C0D">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SplashButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24272A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- 启动骨架：和网页第一帧对齐（同样的标题栏、同样的底色），网页就绪后直接换上去，看不出切换。
             WebView2 是原生子窗口，WPF 元素盖不到它上面，所以不做交叉淡化，入场动画由网页自己播。 -->
        <Grid x:Name="Splash">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0B0C0D" BorderBrush="#222528" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnSplashDrag">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Width="30" Click="OnSplashClose" ToolTip="关闭" Style="{StaticResource SplashButton}">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#7D8287" StrokeThickness="1.4" />
                    </Button>
                    <Button DockPanel.Dock="Right" Width="30" Click="OnSplashMinimize" ToolTip="最小化" Style="{StaticResource SplashButton}">
                        <Path Data="M0,0 L10,0" Stroke="#7D8287" StrokeThickness="1.4" />
                    </Button>
                    <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Grid.RenderTransform>
                        <Border BorderBrush="#22E3B2" BorderThickness="1.5" />
                        <Rectangle Fill="#22E3B2" Margin="3" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Text="卫戍协议助手"
                               FontFamily="Microsoft YaHei UI" FontWeight="Bold" FontSize="13" Foreground="#ECEDEE" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.Background>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="1.2" RadiusY="0.6">
                        <GradientStop Color="#15171A" Offset="0" />
                        <GradientStop Color="#0B0C0D" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle x:Name="SplashDot" Width="8" Height="8" Fill="#22E3B2" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" />
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                    <TextBlock Margin="0,10,0,0" Text="正在载入" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#7D8287" />
                </StackPanel>
            </Grid>
        </Grid>
        <wv:WebView2 x:Name="Browser" Visibility="Hidden" />
    </Grid>
</Window>
