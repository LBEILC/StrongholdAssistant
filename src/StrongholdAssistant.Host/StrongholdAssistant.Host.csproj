<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StrongholdAssistant</AssemblyName>
    <AssemblyTitle>高效雅雅·卫戍协议助手</AssemblyTitle>
    <Product>高效雅雅·卫戍协议助手</Product>
    <ApplicationIcon>../../branding/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Resource Include="../../branding/icon.ico" Link="icon.ico" />
    <ProjectReference Include="../ASPAssistant.Core/ASPAssistant.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="../../data/**/*" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../ui/dist/**/*" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- 两名同名干员的新增素材由数据层提供；覆盖旧构建中的 Pith 头像，不改前端源码。 -->
    <Content Remove="../ui/dist/assets/data/operators/Pith.webp" />
    <Content Include="../../data/operator_icons/*.webp" Link="ui/assets/data/operators/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/skins/char_509_acast%231.webp;../../data/skins/char_616_pithst%231.webp;../../data/skins/char_616_pithst%232.webp" Link="ui/assets/data/skins/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/skills/skchr_acast_1.webp;../../data/skills/skchr_pithst_1.webp" Link="ui/assets/data/skills/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/modules/uniequip_002_pithst.webp" Link="ui/assets/data/modules/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireBuiltUi" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../ui/dist/index.html')" Text="界面产物不存在，请先运行 npm --prefix src/ui run build" />
  </Target>
</Project>
